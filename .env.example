# Cloudflare Worker API base URL for persistent voting.
# Example: https://chatgpt-gallery-votes.your-account.workers.dev
NEXT_PUBLIC_VOTE_API_BASE=

# Supabase project URL and public anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key for server-side reads/writes and auth verification.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for storage bucket name.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=conversation-screenshots
